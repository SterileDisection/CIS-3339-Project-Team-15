# Template for backend/.env - this file is safe to commit, the real .env is not.
#
# Graders: the team's real backend/.env (with the working Atlas connection string) was
# submitted separately on Canvas. Save it as backend/.env, then run npm run db:init.
#
# To set up your own: copy this file to backend/.env and fill in the values marked <...>.
# .env is listed in .gitignore, so it is never committed to the public repository.

# MongoDB connection string, e.g. a MongoDB Atlas cluster:
#   mongodb+srv://<db-user>:<db-password>@<cluster-host>/dataplatform?retryWrites=true&w=majority
# or a local MongoDB: mongodb://127.0.0.1:27017/dataplatform
MONGO_URL=<your MongoDB connection string>
PORT=3000
# _id of the organization this backend serves (any 24-character hex id; db:init creates it)
ORG_ID=239fec8838759376ed597a61
# long random string, e.g. the output of: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=<long random secret>
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
SEED_ORG_NAME=Community Health Center
SEED_VIEWER_USERNAME=user
SEED_VIEWER_PASSWORD=user
SEED_EDITOR_USERNAME=admin
SEED_EDITOR_PASSWORD=admin
